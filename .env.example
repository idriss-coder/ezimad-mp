# MongoDB Atlas — base partagée : les collections EZIMAD sont préfixées `ezimad_`
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/DBNAME?retryWrites=true&w=majority
# Optionnel : nom de la base si absent de l'URI
MONGODB_DB=

# Secret de signature du cookie salarié (32+ caractères). Générer : openssl rand -base64 48
EZIMAD_SESSION_SECRET=

# URL publique du site (métadonnées / Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
